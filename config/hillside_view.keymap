#define L_BASE 0
#define L_NAV 1
#define L_SYM 2
#define L_WM	3
#define L_MOUSE	4

#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi> // requires auto-layer module
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include "mouse.dtsi"



&chosen { zmk,matrix_transform = &five_column_transform; };

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            key-positions = <11 12>;
            bindings = <&kp ESC>;
            layers = <0 2>;
        };

        tab {
            key-positions = <2 1>;
            bindings = <&kp TAB>;
            layers = <0>;
        };

        remove-word {
            bindings = <&kp LA(BACKSPACE)>;
            key-positions = <7 8>;
            layers = <0>;
        };

        control {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <33 38>;
            layers = <0>;
        };

        mouse_lclk {
            bindings = <&mkp LCLK>;
            key-positions = <13 12>;
            layers = <0>;
            require-prior-idle-ms = <50>;
        };

        mouse_rclk {
            bindings = <&momouse 4 RCLK>;
            key-positions = <3 2>;
            layers = <0>;
        };
    };
};

/ {
    /* assign `input-listener` to all pointing devices */
    /* &glidepoint0 on central, &glidepoint1 on peripheral */

    tpad_central_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&glidepoint0>;
        y-invert;
        scale-multiplier = <3>;

        // xy-swap;
        // x-invert;
    };

    tpad_peripheral_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&glidepoint1>;
        layers = <L_BASE L_SYM L_WM>;
        y-invert;
        scale-multiplier = <3>;

        /* NOTE: do NOT override event code here, */
        /*       let Cirque glidepoint reports click from taps */
        // evt-type = <INPUT_EV_REL>;
        // x-input-code = <INPUT_REL_X>;
        // y-input-code = <INPUT_REL_Y>;
    };

    tpad_peripheral_scroll {
        compatible = "zmk,input-behavior-listener";
        device = <&glidepoint1>;
        layers = <L_NAV L_MOUSE>;

        /* NOTE: only apply input-code overriding for INPUT_EV_REL */

        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_HWHEEL>;
        y-input-code = <INPUT_REL_WHEEL>;
        bindings = <&ib_wheel_scaler 1 5>;
    };

    ib_wheel_scaler: ib_wheel_scaler {
        compatible = "zmk,input-behavior-scaler";
        #binding-cells = <2>;
        evt-type = <INPUT_EV_REL>;
        input-code = <INPUT_REL_WHEEL>;
    };
};

