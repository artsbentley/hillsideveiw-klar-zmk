#define L_BASE 0
#define L_NAV 1
#define L_SYM 2

// Layers must be defined before base.keymap is imported, since it defines
// certain entities based on the existence of layers that only exist on boards
// big enough to have keys to access them.

#include "hillside_view-labels.h"
#include "base.keymap"
#include "mouse.dtsi"

&chosen { zmk,matrix_transform = &five_column_transform; };

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            key-positions = <11 12>;
            bindings = <&kp ESC>;
            layers = <0 2>;
        };

        tab {
            key-positions = <2 1>;
            bindings = <&kp TAB>;
            layers = <0>;
        };

        remove-word {
            bindings = <&kp LA(BACKSPACE)>;
            key-positions = <7 8>;
            layers = <0>;
        };

        control {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <33 36>;
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <2 7>;
        };
    };
};

/ {
    /* assign `input-listener` to all pointing devices */
    /* &glidepoint0 on central, &glidepoint1 on peripheral */

    tpad_central_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&glidepoint0>;
        y-invert;
        scale-multiplier = <5>;

        // xy-swap;
        // x-invert;
    };

    tpad_peripheral_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&glidepoint1>;

        // MOUSE LAYERS

        layers = <L_BASE L_SYM L_WM>;
        y-invert;
        scale-multiplier = <5>;

        /* NOTE: do NOT override event code here, */
        /*       let Cirque glidepoint reports click from taps */
        // evt-type = <INPUT_EV_REL>;
        // x-input-code = <INPUT_REL_X>;
        // y-input-code = <INPUT_REL_Y>;
    };

    // SCROLLING LAYERS

    tpad_peripheral_scroll {
        compatible = "zmk,input-behavior-listener";
        device = <&glidepoint1>;
        layers = <L_NAV>;

        /* NOTE: only apply input-code overriding for INPUT_EV_REL */

        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_HWHEEL>;
        y-input-code = <INPUT_REL_WHEEL>;
        bindings = <&ib_wheel_scaler 1 8>;
    };

    ib_wheel_scaler: ib_wheel_scaler {
        compatible = "zmk,input-behavior-scaler";
        #binding-cells = <2>;
        evt-type = <INPUT_EV_REL>;
        input-code = <INPUT_REL_WHEEL>;
    };
};

