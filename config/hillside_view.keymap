#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        momouse: momouse {
            compatible = "zmk,behavior-hold-tap";
            label = "MOMOUSE";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        L_BASE {
            bindings = <
  &kp Q             &kp W               &kp F        &kp P           &kp B  &kp J  &kp L            &kp U                     &kp Y                    &bootloader
  &kp A             &kp R               &kp S        &kp T           &kp G  &kp M  &kp N            &kp E                     &kp I                    &kp O
  &mt LEFT_SHIFT Z  &mt LEFT_COMMAND X  &kp C        &kp D           &kp V  &kp K  &kp H            &kp COMMA                 &mt LEFT_COMMAND PERIOD  &mt LEFT_SHIFT MINUS
                                        &mkp LCLK                                                   &kp ESCAPE
  &mo 3             &sl 2               &lt 1 SPACE  &kp LEFT_SHIFT                &momouse 1 LCLK  &mt LEFT_SHIFT BACKSPACE  &kp ENTER                &kp RIGHT_ALT
            >;
        };

        L_NAV {
            bindings = <
  &kp N1                           &kp N2                             &kp N3             &kp N4           &kp N5      &kp N6    &kp N7    &kp N8  &kp N9     &kp N0
  &kp F5                           &msc SCRL_DOWN                     &msc SCRL_UP       &mkp LCLK        &mkp RCLK   &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp MINUS
  &mt LEFT_SHIFT C_BRIGHTNESS_DEC  &mt LEFT_COMMAND C_BRIGHTNESS_INC  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp K_MUTE  &trans    &trans    &trans  &trans     &bootloader
                                                                      &trans                                                              &trans
  &trans                           &trans                             &trans             &trans                                 &trans    &trans  &trans     &trans
            >;
        };

        L_SYM {
            bindings = <
  &kp EXCL       &kp AT     &kp HASH           &kp DOLLAR     &kp PERCENT  &kp LESS_THAN   &kp LEFT_BRACKET      &kp EQUAL  &kp RIGHT_BRACKET      &kp GREATER_THAN
  &kp QUESTION   &kp SQT    &kp DOUBLE_QUOTES  &kp SEMI       &kt TILDE    &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp COLON  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE
  &kp BACKSLASH  &kp CARET  &kp PIPE           &kp AMPERSAND  &kp GRAVE    &kp SLASH       &kp UNDER             &kp MINUS  &kp PLUS               &kp STAR
                            &trans                                                                               &trans
  &trans         &trans     &trans             &trans                                      &trans                &trans     &trans                 &trans
            >;
        };

        L_WM {
            bindings = <
  &kp LA(Q)  &kp LA(W)  &kp LA(F)  &kp LA(P)  &kp LA(B)  &kp LA(J)  &kp LA(J)  &kp LA(U)       &kp LA(Y)       &trans
  &kp LA(A)  &kp LA(R)  &kp LA(S)  &kp LA(T)  &kp LA(G)  &kp LA(M)  &kp LA(N)  &kp LA(E)       &kp LA(I)       &kp LA(O)
  &kp LA(Z)  &kp LA(X)  &kp LA(C)  &kp LA(D)  &kp LA(V)  &kp LA(K)  &kp LA(H)  &kp LA(COMMA)   &kp LA(PERIOD)  &kp
                        &kp                                                    &kp
  &kp        &kp        &kp        &kp                              &kp        &kp LEFT_SHIFT  &kp             &kp
            >;
        };
    };
};

