#define L_ENGRAM 0
#define L_DVORAK 1
#define L_SYMS 2
#define L_NUMS 3
#define L_NAV 4

// Layers must be defined before base.keymap is imported, since it defines
// certain entities based on the existence of layers that only exist on boards
// big enough to have keys to access them.
#include "hillside_view-labels.h"
#include "base.keymap"
#include "mouse.dtsi"

&chosen {
	zmk,matrix_transform = &five_column_transform;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            key-positions = <11 12>;
            bindings = <&kp ESC>;
            layers = <0 2>;
        };

        tab {
            key-positions = <2 1>;
            bindings = <&kp TAB>;
            layers = <0>;
        };

        remove-word {
            bindings = <&kp LA(BACKSPACE)>;
            key-positions = <7 8>;
            layers = <0>;
        };

        control {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <33 36>;

        };
        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <2 7>;
        };
    };
};


/ {
	/* assign `input-listener` to all pointing devices */
	/* &glidepoint0 on central, &glidepoint1 on peripheral */
    tpad_central_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&glidepoint0>;
        y-invert;
        scale-multiplier = <5>;
        // xy-swap;
        // x-invert;
	};

    tpad_peripheral_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&glidepoint1>;
        layers = <L_DVORAK L_ENGRAM L_SYMS L_NAV>;
        y-invert;
        scale-multiplier = <5>;
        /* NOTE: do NOT override event code here, */
        /*       let Cirque glidepoint reports click from taps */
        // evt-type = <INPUT_EV_REL>;
        // x-input-code = <INPUT_REL_X>;
        // y-input-code = <INPUT_REL_Y>;
    };

    tpad_peripheral_scroll {
        compatible = "zmk,input-behavior-listener";
        device = <&glidepoint1>;
        layers = <L_NUMS>;
        /* NOTE: only apply input-code overriding for INPUT_EV_REL */
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_HWHEEL>;
        y-input-code = <INPUT_REL_WHEEL>;
        bindings = <&ib_wheel_scaler 1 8>;
    };

    ib_wheel_scaler: ib_wheel_scaler {
		compatible = "zmk,input-behavior-scaler";
		#binding-cells = <2>;
		evt-type = <INPUT_EV_REL>;
		input-code = <INPUT_REL_WHEEL>;
    };
};



#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
  &kp Q        &kp W       &kp F      &kp P      &kp B  &kp J  &kp L          &kp U          &kp Y      &bootloader
  &kp A        &kp R       &kp S      &kp T      &kp G  &kp M  &kp N          &kp E          &kp I      &kp O
  &kp Z        &kp X       &kp C      &kp D      &kp V  &kp K  &kp H          &kp PERIOD     &kp COMMA  &kp SLASH
                           &mkp LCLK                                          &kp ESCAPE
  &bootloader  &kp ESCAPE  &kp SPACE  &kp SPACE                &kp BACKSPACE  &kp BACKSPACE  &kp ENTER  &kp RIGHT_ALT
            >;
        };
    };
};

